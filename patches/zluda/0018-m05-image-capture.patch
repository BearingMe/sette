+/// Geometry of a live array, recorded at creation so a diagnostic capture can
+/// read it back without a driver query. `format`/`channels` are the *backing*
+/// storage HIP allocated; `original_format` keeps CUDA's requested enum when it
+/// differs (packed 10:10:10:2 and the normalized 8/16-bit families).
+#[derive(Clone, Copy)]
+pub(crate) struct ArrayRecord {
+    pub(crate) width: usize,
+    pub(crate) height: usize,
+    pub(crate) depth: usize,
+    pub(crate) format: u32,
+    pub(crate) channels: u32,
+}
+
+fn records() -> &'static Mutex<HashMap<usize, ArrayRecord>> {
+    static RECORDS: OnceLock<Mutex<HashMap<usize, ArrayRecord>>> = OnceLock::new();
+    RECORDS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+pub(crate) fn record(array: hipArray_t) -> Option<ArrayRecord> {
+    records().lock().ok()?.get(&(array as usize)).copied()
+}
+
+fn remember(array: hipArray_t, record: ArrayRecord) {
+    if let Ok(mut records) = records().lock() {
+        records.insert(array as usize, record);
+    }
+}
+
+fn forget(array: hipArray_t) {
+    if let Ok(mut records) = records().lock() {
+        records.remove(&(array as usize));
+    }
+}
+
