+/// The resource descriptor an existing (device-side) surface object was created
+/// from. Diagnostic use only; the capture hook needs the array behind the handle.
+pub(crate) fn resource_desc(surface: usize) -> Option<HIP_RESOURCE_DESC> {
+    let resources = surface_resources().lock().ok()?;
+    let info = resources.get(&surface)?;
+    let bytes = &info.descriptor;
+    if bytes.len() != std::mem::size_of::<HIP_RESOURCE_DESC>() {
+        return None;
+    }
+    let mut descriptor: HIP_RESOURCE_DESC = unsafe { std::mem::zeroed() };
+    unsafe {
+        std::ptr::copy_nonoverlapping(
+            bytes.as_ptr(),
+            (&mut descriptor as *mut HIP_RESOURCE_DESC).cast::<u8>(),
+            bytes.len(),
+        );
+    }
+    Some(descriptor)
+}
