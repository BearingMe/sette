new file mode 100644
index 0000000..be36f9a
--- /dev/null
+++ b/zluda/src/impl/image_capture.rs
@@ -0,0 +1,315 @@
+//! Diagnostic capture of image-backed CUDA resources.
+//!
+//! The buffer hook in `d4r_replay` can only see allocations that a kernel's
+//! parameter block points at directly. Preset M's `enc0`, `dec0`, `post` and
+//! `downsample` instead bind CUDA texture and surface *objects*: the parameter
+//! holds a device-side handle, and the pixels live in the array behind it. This
+//! module resolves a handle back to its `HIP_RESOURCE_DESC` (recorded when the
+//! object was created), then to the array or pitched allocation, and reads the
+//! storage with an ordinary HIP copy.
+//!
+//! Rules this module keeps:
+//!   * a read is a copy, never a write: the captured resource is not modified;
+//!   * only storage HIP actually allocated is recorded - a packed 10:10:10:2
+//!     array is dumped as its RGBA32F backing, and `original` says so;
+//!   * an object whose resource type is not handled is reported, not skipped
+//!     silently, so the audit can name the missing binding;
+//!   * the same array bound through two handles is one target, which keeps
+//!     alias information (a surface `dec0` writes and a texture `post` reads are
+//!     the same bytes) instead of duplicating it.
+//!
+//! Never enabled unless the replay hook itself is enabled by
+//! `D4R_CUDA_REPLAY_DUMP_DIR`; the registries it reads are cheap metadata only.
+
+use crate::r#impl::{array, surf, tex};
+use hip_runtime_sys::*;
+
+/// One parameter-block slot binding this object.
+#[derive(Clone, Copy)]
+pub(crate) struct Binding {
+    pub(crate) offset: usize,
+    pub(crate) kind: &'static str,
+}
+
+/// Where the pixels actually live.
+#[derive(Clone, Copy)]
+pub(crate) enum Storage {
+    Array { array: hipArray_t },
+    Pitched { device: hipDeviceptr_t, pitch: usize },
+}
+
+/// A resolved image binding: identity, geometry and a reproducible readout.
+pub(crate) struct Target {
+    pub(crate) kind: &'static str,
+    pub(crate) handle: usize,
+    pub(crate) storage: Storage,
+    pub(crate) bindings: Vec<Binding>,
+    pub(crate) width: usize,
+    pub(crate) height: usize,
+    pub(crate) depth: usize,
+    pub(crate) format: u32,
+    pub(crate) channels: u32,
+    pub(crate) original: Option<u32>,
+    pub(crate) row_bytes: usize,
+    /// Source row stride for pitched storage; 0 when the storage is an array.
+    pub(crate) pitch: usize,
+    pub(crate) bytes: usize,
+}
+
+impl Target {
+    /// Two handles on the same storage are one target.
+    pub(crate) fn same_storage(&self, other: &Target) -> bool {
+        match (self.storage, other.storage) {
+            (Storage::Array { array: a }, Storage::Array { array: b }) => a == b,
+            (
+                Storage::Pitched { device: a, pitch: pa },
+                Storage::Pitched { device: b, pitch: pb },
+            ) => a.0 == b.0 && pa == pb,
+            _ => false,
+        }
+    }
+
+    pub(crate) fn array_address(&self) -> Option<usize> {
+        match self.storage {
+            Storage::Array { array } => Some(array as usize),
+            Storage::Pitched { .. } => None,
+        }
+    }
+
+    pub(crate) fn pitched_address(&self) -> Option<usize> {
+        match self.storage {
+            Storage::Pitched { device, .. } => Some(device.0 as usize),
+            Storage::Array { .. } => None,
+        }
+    }
+}
+
+/// Byte size of one channel for the HIP/CUDA array formats HIP accepts.
+///
+/// HIP reuses CUDA's `CUarray_format` numbering: 0x01/0x08 are 8-bit,
+/// 0x02/0x09/0x10 (HALF) are 16-bit, 0x03/0x0A/0x20 (FLOAT) are 32-bit.
+pub(crate) fn element_bytes(format: u32) -> Option<usize> {
+    match format {
+        0x01 | 0x08 => Some(1),
+        0x02 | 0x09 | 0x10 => Some(2),
+        0x03 | 0x0a | 0x20 => Some(4),
+        _ => None,
+    }
+}
+
+fn geometry(
+    width: usize,
+    height: usize,
+    depth: usize,
+    format: u32,
+    channels: u32,
+) -> Result<(usize, usize), String> {
+    let element = element_bytes(format)
+        .ok_or_else(|| format!("unknown array format 0x{format:02x}"))?;
+    if channels == 0 || channels > 4 {
+        return Err(format!("implausible channel count {channels}"));
+    }
+    let row_bytes = width * channels as usize * element;
+    let bytes = row_bytes * height.max(1) * depth.max(1);
+    if bytes == 0 {
+        return Err("zero-extent image".to_owned());
+    }
+    Ok((row_bytes, bytes))
+}
+
+/// Resolve one parameter-block value to an image, if it is a texture or surface
+/// object created in this process.
+///
+/// `Ok(None)` means "not an image handle" (the caller treats it as a buffer).
+/// `Ok(Some(Err(..)))` means "an image handle this hook cannot read": the
+/// caller records the reason so no binding disappears without a trace.
+#[allow(clippy::type_complexity)]
+pub(crate) fn resolve(handle: usize) -> Option<Result<Target, String>> {
+    for (kind, descriptor) in [
+        ("tex", tex::resource_desc(handle)),
+        ("surf", surf::resource_desc(handle)),
+    ] {
+        let Some(descriptor) = descriptor else { continue };
+        return Some(from_descriptor(kind, handle, descriptor));
+    }
+    None
+}
+
+fn from_descriptor(
+    kind: &'static str,
+    handle: usize,
+    descriptor: HIP_RESOURCE_DESC,
+) -> Result<Target, String> {
+    let resource = descriptor.resType;
+    if resource == HIPresourcetype::HIP_RESOURCE_TYPE_ARRAY {
+        let raw = unsafe { descriptor.res.array.hArray };
+        if raw.is_null() {
+            return Err("array object with a null array handle".to_owned());
+        }
+        let record = array::record(raw).ok_or_else(|| {
+            format!(
+                "array 0x{:x} was not created through this hook's array registry",
+                raw as usize
+            )
+        })?;
+        let (row_bytes, bytes) = geometry(
+            record.width,
+            record.height,
+            record.depth,
+            record.format,
+            record.channels,
+        )?;
+        return Ok(Target {
+            kind,
+            handle,
+            storage: Storage::Array { array: raw },
+            bindings: Vec::new(),
+            width: record.width,
+            height: record.height,
+            depth: record.depth,
+            format: record.format,
+            channels: record.channels,
+            original: array::original_format(raw).ok().flatten(),
+            row_bytes,
+            pitch: 0,
+            bytes,
+        });
+    }
+    if resource == HIPresourcetype::HIP_RESOURCE_TYPE_PITCH2D {
+        let p = unsafe { descriptor.res.pitch2D };
+        if p.devPtr.0.is_null() {
+            return Err("pitched object with a null device pointer".to_owned());
+        }
+        let (natural_row, _) = geometry(p.width, p.height, 1, p.format.0, p.numChannels)?;
+        let pitch = if p.pitchInBytes == 0 { natural_row } else { p.pitchInBytes };
+        if pitch < natural_row {
+            return Err(format!(
+                "pitched object: pitch {pitch} is narrower than one row ({natural_row})"
+            ));
+        }
+        return Ok(Target {
+            kind,
+            handle,
+            storage: Storage::Pitched { device: p.devPtr, pitch },
+            bindings: Vec::new(),
+            width: p.width,
+            height: p.height,
+            depth: 1,
+            format: p.format.0,
+            channels: p.numChannels,
+            original: None,
+            row_bytes: natural_row,
+            pitch,
+            bytes: natural_row * p.height.max(1),
+        });
+    }
+    if resource == HIPresourcetype::HIP_RESOURCE_TYPE_LINEAR {
+        let p = unsafe { descriptor.res.linear };
+        if p.devPtr.0.is_null() || p.sizeInBytes == 0 {
+            return Err("linear object with null storage".to_owned());
+        }
+        // A linear resource has no pitch: one row of `sizeInBytes` bytes, read raw.
+        return Ok(Target {
+            kind,
+            handle,
+            storage: Storage::Pitched {
+                device: p.devPtr,
+                pitch: p.sizeInBytes,
+            },
+            bindings: Vec::new(),
+            width: p.sizeInBytes,
+            height: 1,
+            depth: 1,
+            format: 0x01,
+            channels: 1,
+            original: None,
+            row_bytes: p.sizeInBytes,
+            pitch: p.sizeInBytes,
+            bytes: p.sizeInBytes,
+        });
+    }
+    Err(format!(
+        "resource type {:?} (mipmapped or reserved) has no readback path here",
+        resource
+    ))
+}
+
+/// Copy the image's storage to host memory without modifying the resource.
+pub(crate) unsafe fn read(target: &Target) -> Result<Vec<u8>, String> {
+    let mut buffer = vec![0u8; target.bytes];
+    match target.storage {
+        Storage::Array { array } => {
+            if target.depth <= 1 {
+                let mut copy: hip_Memcpy2D = std::mem::zeroed();
+                copy.srcMemoryType = hipMemoryType::hipMemoryTypeArray;
+                copy.srcArray = array;
+                copy.dstMemoryType = hipMemoryType::hipMemoryTypeHost;
+                copy.dstHost = buffer.as_mut_ptr().cast();
+                copy.dstPitch = target.row_bytes;
+                copy.WidthInBytes = target.row_bytes;
+                copy.Height = target.height;
+                hipMemcpyParam2D(&copy)
+                    .map_err(|error| format!("array readback failed: {error:?}"))?;
+            } else {
+                let mut copy: HIP_MEMCPY3D = std::mem::zeroed();
+                copy.srcMemoryType = hipMemoryType::hipMemoryTypeArray;
+                copy.srcArray = array;
+                copy.dstMemoryType = hipMemoryType::hipMemoryTypeHost;
+                copy.dstHost = buffer.as_mut_ptr().cast();
+                copy.dstPitch = target.row_bytes;
+                copy.dstHeight = target.height;
+                copy.WidthInBytes = target.row_bytes;
+                copy.Height = target.height;
+                copy.Depth = target.depth;
+                hipDrvMemcpy3D(&copy)
+                    .map_err(|error| format!("3D array readback failed: {error:?}"))?;
+            }
+        }
+        Storage::Pitched { device, pitch } => {
+            // One linear copy of the whole pitched region, then pack the rows.
+            // A 2D copy would depend on the driver's 2D path; a linear copy plus
+            // an explicit repack keeps the dumped layout defined by `row_bytes`
+            // alone, which is what the manifest promises.
+            let mut raw = vec![0u8; pitch * target.height.max(1)];
+            hipMemcpy(
+                raw.as_mut_ptr().cast(),
+                device.0.cast(),
+                raw.len(),
+                hipMemcpyKind::hipMemcpyDeviceToHost,
+            )
+            .map_err(|error| format!("pitched readback failed: {error:?}"))?;
+            for row in 0..target.height.max(1) {
+                let from = row * pitch;
+                let to = row * target.row_bytes;
+                buffer[to..to + target.row_bytes]
+                    .copy_from_slice(&raw[from..from + target.row_bytes]);
+            }
+        }
+    }
+    Ok(buffer)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn array_formats_map_to_storage_widths() {
+        assert_eq!(element_bytes(0x01), Some(1));
+        assert_eq!(element_bytes(0x08), Some(1));
+        assert_eq!(element_bytes(0x02), Some(2));
+        assert_eq!(element_bytes(0x10), Some(2));
+        assert_eq!(element_bytes(0x20), Some(4));
+        assert_eq!(element_bytes(0x00), None);
+        assert_eq!(element_bytes(0x40), None);
+    }
+
+    #[test]
+    fn geometry_is_exact() {
+        assert_eq!(geometry(37, 13, 1, 0x10, 4).unwrap(), (37 * 8, 37 * 8 * 13));
+        assert_eq!(geometry(960, 540, 1, 0x20, 4).unwrap(), (15360, 15360 * 540));
+        assert!(geometry(4, 4, 1, 0x77, 1).is_err());
+        assert!(geometry(4, 4, 1, 0x10, 0).is_err());
+        assert!(geometry(0, 4, 1, 0x10, 1).is_err());
+    }
+}
